{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-radar.local/schemas/report.schema.json",
  "title": "Published report read model",
  "description": "Read model của một kỳ báo cáo đã publish (SRC-PLAN §8.2 report.status published). Bất biến sau publish (I05). Ngữ nghĩa của từng trường nằm ở contracts/reporting/time-and-tags.md và contracts/reporting/selection.md; schema này chỉ khóa hình dạng wire.",
  "x-contract": {
    "contract_id": "CT-schema-report",
    "version": "0.1.0",
    "status": "draft",
    "owner_role": "reporting contract owner",
    "source_refs": [
      "SRC-SPEC §3.5 D23, D27, D29, D53, D54, D57",
      "SRC-SPEC §4 (Report detail)",
      "SRC-SPEC §10.1, §10.3, §10.4",
      "SRC-SPEC §12 AC-05, AC-08, AC-09, AC-10",
      "SRC-PLAN §5.1 (wire rules)",
      "SRC-PLAN §7 I05, I06, I07, I12",
      "SRC-PLAN §8.2",
      "SRC-PLAN §9.2",
      "SRC-PLAN §11 PC04"
    ],
    "requirement_refs": [
      "REQ-D23",
      "REQ-D27",
      "REQ-D29",
      "REQ-D53",
      "REQ-D54",
      "REQ-D57",
      "REQ-AC05",
      "REQ-AC08",
      "REQ-AC09",
      "REQ-AC10",
      "REQ-P0-07"
    ],
    "decision_refs": [
      "B01",
      "B04",
      "B14",
      "B17",
      "AMD-B01",
      "AMD-B04",
      "AMD-B17",
      "ADR-0004"
    ],
    "invariant_refs": [
      "I05",
      "I06",
      "I07",
      "I12"
    ],
    "producers": [
      "MOD-report-service"
    ],
    "consumers": [
      "MOD-web-ui",
      "MOD-backend-api",
      "MOD-telegram-adapter",
      "MOD-delivery-service"
    ],
    "dependencies": [
      "contracts/schemas/target.schema.json",
      "contracts/reporting/time-and-tags.md",
      "contracts/reporting/selection.md",
      "contracts/data/entities.yaml",
      "contracts/state/report.yaml"
    ],
    "scope": "Hình dạng đọc được của một report đã publish: coverage, phiên bản đã ghim, mục, khối hướng đang nổi, danh sách pending và ghi chú coverage. Không mô tả bảng vật lý (entities.yaml) và không định nghĩa nội dung summary (PC06).",
    "verification": "EV-PC04-01: metaschema Draft 2020-12 + mọi expected.report trong acceptance/fixtures/reporting/ validate theo schema này, với target.schema.json nạp vào resolver store.",
    "claim_ceiling": "DRAFT_FOR_REVIEW",
    "external_schema_refs": {
      "analysis_result": {
        "schema_id": "https://research-radar.local/schemas/analysis-result.schema.json",
        "owner_package": "PC06",
        "note": "Chỉ tham chiếu bằng ID. Schema này KHÔNG định nghĩa nội dung summary; xem contracts/ai/tasks.yaml và contracts/schemas/analysis-result.schema.json (PC06)."
      }
    },
    "not_in_read_model": {
      "abort_reason": "Cột report.abort_reason (entities.yaml) KHÔNG có trong read model này: `status` là const 'published', còn abort_reason NOT NULL khi và chỉ khi status='aborted'. Một report đã publish không bao giờ có abort_reason, nên đưa nó vào đây sẽ là một trường luôn null. Nó được kiểm ở fixture d và ở contracts/state/report.yaml.",
      "report_build_id_note": "NGƯỢC LẠI, report_build_id CÓ trong read model: nó tồn tại trên mọi hàng report bất kể status, và consumer cần nó để đối chiếu receipt của một lần publish."
    },
    "fix_ref": "PKT-PC04-FIX1 (F-A1R2-01): thêm report_build_id sau khi PC02-FIX3 khai cột này trong entities.yaml."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_build_id",
    "owner_id",
    "status",
    "quality",
    "coverage",
    "tag_config_version",
    "selection_version",
    "embedding_generation",
    "items",
    "emerging_directions",
    "pending_items",
    "coverage_note",
    "built_at",
    "published_at",
    "content_hash",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Phiên bản của chính schema này (SRC-PLAN §5.1). Không dùng 'latest'."
    },
    "report_id": {
      "$ref": "#/$defs/ulid"
    },
    "report_build_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv4. Mỏ neo idempotency ĐÃ BỀN của report.publish — cột report.report_build_id (entities.yaml, UNIQUE ux_report_owner_build_id). Replay sau khi mất ACK tra theo khóa này thay vì thử advance coverage lần hai (SRC-PLAN §5.1). Đây là tiền đề của quyết định kỳ rỗng ở time-and-tags.md §4.7.1."
    },
    "owner_id": {
      "$ref": "#/$defs/ulid"
    },
    "status": {
      "type": "string",
      "const": "published",
      "description": "Read model chỉ tồn tại cho report đã publish. `building` và `aborted` không có read model hiển thị (SRC-PLAN §8.2)."
    },
    "quality": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ],
      "description": "Trường RIÊNG với status (B17/AMD-B17). `complete` chỉ khi pending_items rỗng cho kỳ này."
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "tag_config_version": {
      "$ref": "#/$defs/tag_config_version_ref"
    },
    "selection_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Phiên bản thuật toán selection (contracts/reporting/selection.md §1). Ghim bất biến."
    },
    "embedding_generation": {
      "$ref": "#/$defs/embedding_generation_ref"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report_item"
      },
      "description": "Đã sắp theo selection.md §7.1. Mảng rỗng KHÔNG hợp lệ cho một report đã publish: kỳ rỗng chỉ ghi coverage, không tạo report hiển thị (REQ-D57, AMD-B04).",
      "minItems": 1
    },
    "emerging_directions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/emerging_direction"
      },
      "minItems": 1,
      "description": "Luôn có ít nhất một phần tử: khi không nhóm nào đạt ngưỡng, phần tử đó mang evidence_state = 'insufficient_evidence' (B14)."
    },
    "pending_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending_item"
      },
      "description": "Mục thuộc kỳ này nhưng chưa đủ điều kiện hiển thị đầy đủ. Rỗng là điều kiện cần của quality = 'complete'."
    },
    "coverage_note": {
      "$ref": "#/$defs/coverage_note"
    },
    "built_at": {
      "$ref": "#/$defs/timestamp_utc_ms"
    },
    "published_at": {
      "$ref": "#/$defs/timestamp_utc_ms",
      "description": "Commit point của transaction publish; là mốc freeze tag (B01) và mốc first-announcement (I07)."
    },
    "content_hash": {
      "$ref": "#/$defs/sha256",
      "description": "sha256(JCS(nội dung đã publish)). Oracle của I05: delivery không đổi nội dung đã publish."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "description": "Con trỏ tới evidence record (EV-…) hoặc scenario (SC…) liên quan tới kỳ này. Mảng rỗng hợp lệ."
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID 26 ký tự Crockford base32 chữ hoa; ID luôn truyền dưới dạng string (SRC-PLAN §5.1)."
    },
    "target_key": {
      "type": "string",
      "pattern": "^(work|post):[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "timestamp_utc_ms": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "RFC 3339 UTC, hậu tố Z, đúng ba chữ số mili giây (AMD-B08)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "Cosine similarity đã làm tròn half-up 4 chữ số thập phân (selection.md §3)."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_window_id",
        "sequence",
        "coverage_from",
        "coverage_to",
        "ingest_sequence_from",
        "ingest_sequence_to",
        "predecessor_window_id"
      ],
      "properties": {
        "coverage_window_id": {
          "$ref": "#/$defs/ulid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_from": {
          "$ref": "#/$defs/timestamp_utc_ms",
          "description": "Inclusive."
        },
        "coverage_to": {
          "$ref": "#/$defs/timestamp_utc_ms",
          "description": "EXCLUSIVE — khoảng nửa mở [from, to) (SRC-PLAN §9.2)."
        },
        "ingest_sequence_from": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive. Vị từ thành viên thật sự (time-and-tags.md §4.3)."
        },
        "ingest_sequence_to": {
          "type": "integer",
          "minimum": 0,
          "description": "EXCLUSIVE."
        },
        "predecessor_window_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "NULL chỉ cho cửa sổ đầu tiên. Guard CAS: coverage_from = predecessor.coverage_to (I06)."
        }
      }
    },
    "tag_config_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_config_version_id",
        "sequence",
        "content_hash",
        "frozen_at"
      ],
      "properties": {
        "tag_config_version_id": {
          "$ref": "#/$defs/ulid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "frozen_at": {
          "$ref": "#/$defs/timestamp_utc_ms",
          "description": "Bằng published_at: freeze xảy ra TRONG transaction publish (B01/AMD-B01)."
        }
      }
    },
    "embedding_generation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding_generation_id",
        "model_name",
        "model_version",
        "dimension",
        "normalization"
      ],
      "properties": {
        "embedding_generation_id": {
          "$ref": "#/$defs/ulid"
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Không dùng 'latest' (entities.yaml)."
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "normalization": {
          "type": "string",
          "enum": [
            "l2",
            "none"
          ]
        }
      }
    },
    "matched_tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_id",
        "tag_text",
        "matched_via",
        "score",
        "threshold_applied"
      ],
      "properties": {
        "tag_id": {
          "$ref": "#/$defs/ulid"
        },
        "tag_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "matched_via": {
          "type": "string",
          "enum": [
            "tag",
            "alias"
          ]
        },
        "tag_alias_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "NOT NULL khi matched_via = 'alias'. Alias thừa hưởng ngưỡng của tag cha (selection.md §4.2)."
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "threshold_applied": {
          "$ref": "#/$defs/score"
        },
        "matched_label_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "excluded_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_exclusion_id",
        "exclusion_scope",
        "score",
        "threshold_applied"
      ],
      "properties": {
        "tag_exclusion_id": {
          "$ref": "#/$defs/ulid"
        },
        "exclusion_scope": {
          "type": "string",
          "enum": [
            "global",
            "tag_scoped"
          ]
        },
        "scoped_tag_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "threshold_applied": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "analysis_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "task_type",
        "generation_number",
        "payload_hash",
        "evidence_level",
        "analyzed_at",
        "analysis_result_schema_id"
      ],
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/ulid"
        },
        "task_type": {
          "type": "string",
          "const": "summary"
        },
        "generation_number": {
          "type": "integer",
          "minimum": 1
        },
        "payload_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "post_only",
            "abstract",
            "full_text"
          ],
          "description": "Nhãn mức độ đọc (REQ-D21, REQ-AC11)."
        },
        "analyzed_at": {
          "$ref": "#/$defs/timestamp_utc_ms"
        },
        "analysis_result_schema_id": {
          "type": "string",
          "const": "https://research-radar.local/schemas/analysis-result.schema.json",
          "description": "CHỈ tham chiếu. Nội dung summary do PC06 định nghĩa; schema này không mô tả các trường bên trong payload."
        }
      }
    },
    "first_announced_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_announced_report_id",
        "first_announced_at",
        "first_announced_window_sequence"
      ],
      "properties": {
        "first_announced_report_id": {
          "$ref": "#/$defs/ulid"
        },
        "first_announced_at": {
          "$ref": "#/$defs/timestamp_utc_ms"
        },
        "first_announced_window_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "target_key_at_announcement": {
          "$ref": "#/$defs/target_key"
        },
        "merge_audit_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "first_announced_ledger.merge_audit_id: NOT NULL khi ngày công bố được kế thừa từ work bị hợp nhất (time-and-tags.md §8.3)."
        }
      },
      "description": "Ánh xạ tới first_announced_ledger (entities.yaml): first_announced_report_id = ledger.first_report_id; first_announced_at = ledger.first_announced_at; merge_audit_id = ledger.merge_audit_id. first_announced_window_sequence và target_key_at_announcement là giá trị DẪN XUẤT ở read model (join coverage_window trên report_id, và report_item của kỳ công bố lần đầu) — không phải cột của sổ."
    },
    "report_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_item_id",
        "target",
        "target_key",
        "item_type",
        "matched_tags",
        "late_discovery",
        "selected_via_backfill",
        "identity_state"
      ],
      "properties": {
        "report_item_id": {
          "$ref": "#/$defs/ulid"
        },
        "target": {
          "$ref": "https://research-radar.local/schemas/target.schema.json",
          "description": "Tagged union work | post (PC02)."
        },
        "target_key": {
          "$ref": "#/$defs/target_key"
        },
        "item_type": {
          "type": "string",
          "enum": [
            "new_discovery",
            "prior_reference"
          ],
          "description": "REQ-D29, REQ-AC09. 'phát hiện muộn' KHÔNG phải một item_type — xem late_discovery."
        },
        "first_announced": {
          "$ref": "#/$defs/first_announced_ref"
        },
        "reference_reason": {
          "type": "string",
          "enum": [
            "already_announced",
            "new_work_version",
            "related_direction"
          ],
          "description": "Chỉ có nghĩa khi item_type = 'prior_reference'. 'related_direction' theo REQ-D30 (tag chung + paper cùng được dẫn, KHÔNG dùng AI)."
        },
        "work_version_label": {
          "type": "string",
          "pattern": "^(v[1-9][0-9]{0,2}|journal)$"
        },
        "matched_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matched_tag"
          },
          "minItems": 1,
          "description": "Các cặp khớp SỐNG SÓT sau exclusion (selection.md §4.3)."
        },
        "excluded_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excluded_by"
          },
          "description": "Các cặp bị exclusion loại — dùng để giải thích trên màn hình Topics."
        },
        "analysis": {
          "$ref": "#/$defs/analysis_ref"
        },
        "summary_state": {
          "type": "string",
          "enum": [
            "present",
            "pending"
          ],
          "description": "'pending' khi mục được chọn nhưng chưa có summary hợp lệ; mục vẫn hiển thị, không bị ẩn (AMD-B17)."
        },
        "late_discovery": {
          "type": "boolean",
          "description": "true → hiển thị nhãn 'phát hiện muộn' (time-and-tags.md §5.3). Là nhãn hiển thị, không đổi item_type."
        },
        "pending_since_window_sequence": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_via_backfill": {
          "type": "boolean"
        },
        "backfill_ledger_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_state": {
          "type": "string",
          "enum": [
            "active",
            "quarantined"
          ],
          "description": "'quarantined' = đang có identity_conflict mở; UI phải cảnh báo và mục KHÔNG được đếm vào mật độ (identity.md §5.3)."
        },
        "discovered_at": {
          "$ref": "#/$defs/timestamp_utc_ms"
        },
        "ingest_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "source_post_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ulid"
          },
          "description": "Các post dẫn tới work này (REQ-AC07: một mục công trình, các post nằm dưới dạng nguồn dẫn)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "item_type": {
                "const": "prior_reference"
              }
            },
            "required": [
              "item_type"
            ]
          },
          "then": {
            "required": [
              "first_announced",
              "reference_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "summary_state": {
                "const": "present"
              }
            },
            "required": [
              "summary_state"
            ]
          },
          "then": {
            "required": [
              "analysis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "selected_via_backfill": {
                "const": true
              }
            },
            "required": [
              "selected_via_backfill"
            ]
          },
          "then": {
            "required": [
              "backfill_ledger_id"
            ]
          }
        }
      ],
      "description": "Read model của một hàng report_item. Các trường matched_tags, excluded_by, late_discovery, pending_since_window_sequence, selected_via_backfill, backfill_ledger_id, reference_reason, work_version_label và identity_state là các khóa của cột json report_item.selection_reason (PC04 khóa hình dạng theo entities.yaml); ở đây chúng được trải phẳng cho consumer."
    },
    "density_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "radius",
        "min_members",
        "comparison_window_k",
        "min_prior_windows",
        "min_delta",
        "prior_floor",
        "rounding_decimals"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "const": "cosine"
        },
        "radius": {
          "$ref": "#/$defs/score"
        },
        "min_members": {
          "type": "integer",
          "minimum": 1
        },
        "comparison_window_k": {
          "type": "integer",
          "minimum": 1
        },
        "min_prior_windows": {
          "type": "integer",
          "minimum": 1
        },
        "min_delta": {
          "type": "number"
        },
        "prior_floor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rounding_decimals": {
          "type": "integer",
          "const": 4
        },
        "parameters_status": {
          "type": "string",
          "enum": [
            "PROVISIONAL",
            "PROVISIONAL_BOOTSTRAP",
            "CALIBRATED"
          ],
          "description": "REQ-A4 chưa chạy → không bao giờ là 'CALIBRATED' ở giai đoạn Pre-code."
        }
      }
    },
    "density_measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density_now",
        "density_prior",
        "density_delta",
        "density_ratio",
        "comparison_windows_used"
      ],
      "properties": {
        "density_now": {
          "type": "integer",
          "minimum": 0,
          "description": "Số target_key riêng biệt trong nhóm ở kỳ này."
        },
        "density_prior": {
          "type": "number",
          "minimum": 0,
          "description": "Trung bình cộng trên các kỳ trước TỒN TẠI; không đệm 0 cho kỳ không tồn tại."
        },
        "density_delta": {
          "type": "number"
        },
        "density_ratio": {
          "type": "number",
          "minimum": 0
        },
        "comparison_windows_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coverage_window_sequence",
              "members_in_radius"
            ],
            "properties": {
              "coverage_window_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "members_in_radius": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "emerging_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_id",
        "evidence_state",
        "label",
        "member_target_keys",
        "parameters",
        "embedding_generation_id",
        "excluded_quarantined_target_keys"
      ],
      "properties": {
        "direction_id": {
          "$ref": "#/$defs/ulid"
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "sufficient",
            "insufficient_evidence"
          ],
          "description": "B14: thiếu dữ liệu KHÔNG được gọi là 'đang nổi'."
        },
        "label": {
          "type": "string",
          "const": "ứng viên để đọc sâu",
          "description": "REQ-D54. Chuỗi này là hằng số hợp đồng; 'phát hiện mới' bị cấm."
        },
        "insufficient_reason": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "below_min_sample",
                "cold_start_insufficient_history",
                "delta_below_threshold",
                "generation_reset"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "member_target_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_key"
          },
          "uniqueItems": true
        },
        "centroid": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "description": "Vector centroid đã chuẩn hóa L2, độ dài bằng embedding_generation.dimension. Ghi bất biến để kỳ sau so lại được."
        },
        "density": {
          "$ref": "#/$defs/density_measure"
        },
        "parameters": {
          "$ref": "#/$defs/density_parameters"
        },
        "embedding_generation_id": {
          "$ref": "#/$defs/ulid"
        },
        "excluded_quarantined_target_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_key"
          },
          "uniqueItems": true,
          "description": "Target bị loại khỏi phép đếm vì đang có identity_conflict mở (B15)."
        },
        "phrasing_analysis_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "analysis của task direction_phrasing (PC06). NULL hợp lệ: khối tồn tại được khi không có AI."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "sufficient"
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "density",
              "centroid"
            ],
            "properties": {
              "member_target_keys": {
                "minItems": 1
              },
              "insufficient_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "insufficient_evidence"
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "insufficient_reason"
            ],
            "properties": {
              "member_target_keys": {
                "maxItems": 0
              },
              "insufficient_reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "pending_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_item_ledger_id",
        "target_key",
        "reason",
        "first_pending_window_sequence",
        "state"
      ],
      "properties": {
        "pending_item_ledger_id": {
          "$ref": "#/$defs/ulid"
        },
        "target_key": {
          "$ref": "#/$defs/target_key"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing_summary",
            "analysis_failed",
            "analysis_unknown",
            "budget_exceeded"
          ]
        },
        "first_pending_window_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "resolved_reported_late",
            "abandoned_by_owner"
          ]
        }
      }
    },
    "coverage_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_data_only",
        "empty_period",
        "threshold_calibration_state"
      ],
      "properties": {
        "observed_data_only": {
          "type": "boolean",
          "description": "true = coverage nêu phạm vi dữ liệu ĐÃ QUAN SÁT, không hứa bao phủ toàn bộ thời gian trên X (SRC-PLAN §9.2, B05)."
        },
        "empty_period": {
          "type": "boolean",
          "description": "Luôn false trong một read model đã publish: kỳ rỗng không tạo report hiển thị (REQ-D57). Trường tồn tại để consumer khẳng định được điều đó."
        },
        "run_stop_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ],
          "description": "Ví dụ limit_reached, captcha, session_expired (SRC-PLAN §8.1). Null khi run kết thúc bình thường."
        },
        "source_coverage_limits_note": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ],
          "description": "Câu chữ về giới hạn bao phủ nguồn X (AMD-B05)."
        },
        "threshold_calibration_state": {
          "type": "string",
          "enum": [
            "uncalibrated",
            "calibrated"
          ],
          "description": "REQ-A2 / REQ-OQ08. 'uncalibrated' → UI phải nói rõ ngưỡng chưa hiệu chỉnh; cấm tuyên bố chỉ tiêu chất lượng §1.4."
        },
        "backfill_applied_tag_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ulid"
          },
          "description": "Các tag đã dùng entitlement backfill trong kỳ này (REQ-D28)."
        }
      }
    }
  }
}
